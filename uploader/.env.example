# Copy to uploader/.env and fill in from the TikTok developer portal (App details > Credentials).
# For the sandbox, use the sandbox's own client key and secret.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://ashish-dahal.github.io/ashish-uploader/callback.html

# Optional defaults
# TT_MODE=direct            # or inbox
# TT_PRIVACY=SELF_ONLY      # forced to SELF_ONLY until the app passes TikTok's audit
# TT_QUEUE_DIR=~/tiktok-queue
